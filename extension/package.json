{
  "name": "meeting-capture-extension",
  "version": "0.1.8",
  "description": "Chrome MV3 extension that streams meeting tab audio (Zoom, Google Meet, ...) to a self-hosted streaming ASR service and attributes captions to speakers by scraping the meeting's active-speaker indicator.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "concurrently -c auto 'pnpm:check:*'",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:knip": "knip",
    "check:test": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "a11y": "vite build && node scripts/a11y.mjs",
    "screenshot": "vite build && node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
